# hcc runner daemon. @RUN_USER@ and @GROUP@ are replaced by
# install-runner.sh.
[Unit]
Description=Harness Control Center runner
Documentation=https://github.com/first-it-consulting/harness-control-center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_USER@
# Members of @GROUP@ may use the socket.
SupplementaryGroups=@GROUP@
ExecStart=/usr/local/bin/hcc runner serve --config /etc/hcc/runner.yaml
# /run/hcc (socket, group-accessible) and /var/lib/hcc (state, jails,
# owner-only).
RuntimeDirectory=hcc
RuntimeDirectoryMode=0750
StateDirectory=hcc
StateDirectoryMode=0700
UMask=0077
# On stop the runner stops every VM itself (SIGTERM, then cgroup.kill);
# give it time before systemd kills what is left.
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

# Hardening that still lets sudo run hcc-helper (the jailer writes
# cgroups and creates device nodes in the chroot). NoNewPrivileges and
# ProtectSystem=strict would break sudo's setuid.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
