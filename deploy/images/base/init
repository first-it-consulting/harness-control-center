#!/bin/sh
# Init of the "base" image: boots, reports, shuts down. Its test modes
# (harnesses cannot set kernel arguments) exercise stopping, the kill
# switch, the network guard and results.
. /usr/lib/hcc/common.sh
hcc_mounts
echo "HCC-GUEST-UP kernel=$(uname -r)"
hcc_network
echo "HCC-GUEST-NET interfaces: $(ls /sys/class/net | tr '\n' ' ')"
case " $(cat /proc/cmdline) " in
*" hcc.mode=hang "*) echo "HCC-GUEST-HANG"; while :; do sleep 1; done ;;
*" hcc.mode=nettest "*)
	H=${HCC_PROXY%:*}
	P=${HCC_PROXY##*:}
	probe() { printf 'CONNECT %s HTTP/1.1\r\nHost: %s\r\n\r\n' "$1" "$1" | nc -w 3 "$H" "$P" 2>/dev/null | head -n 1 | tr -d '\r'; }
	echo "HCC-NET-ALLOWED $(probe example.com:443)"
	echo "HCC-NET-DENIED $(probe example.org:443)"
	if nc -w 2 1.1.1.1 443 </dev/null 2>/dev/null; then echo "HCC-NET-DIRECT open"; else echo "HCC-NET-DIRECT blocked"; fi
	if nc -w 2 "$H" 22 </dev/null 2>/dev/null; then echo "HCC-NET-HOSTPORT open"; else echo "HCC-NET-HOSTPORT blocked"; fi
	if [ -s /tmp/hcc-ca.pem ]; then echo "HCC-NET-CA present"; else echo "HCC-NET-CA absent"; fi
	;;
*" hcc.mode=results "*)
	mkdir -p /tmp/out/sub
	echo "hello from the guest" >/tmp/out/sub/hello.txt
	ln -s /etc/shadow /tmp/out/link
	mkfifo /tmp/out/fifo
	hcc_save_results /tmp/out
	;;
*" hcc.mode=install-claude "*)
	# Local setup on a Mac (internal/local): Claude Code is not in the
	# release images, so hcc fetched its npm package (and checked it) onto
	# vdb, hcc.size bytes long, and this adds the binary to the claude-code
	# image on vdc. No network; nothing runs but this.
	size=$(hcc_arg hcc.size)
	case "$size" in '' | *[!0-9]*) echo "HCC-INSTALL-ERROR invalid size"; hcc_shutdown ;; esac
	if mount -t ext4 /dev/vdc /mnt &&
		head -c "$size" /dev/vdb | tar -xzO package/claude >/mnt/usr/local/bin/claude &&
		chmod 0755 /mnt/usr/local/bin/claude &&
		mount -t tmpfs tmpfs /mnt/tmp && mount -t proc proc /mnt/proc && mount --bind /dev /mnt/dev &&
		v=$(HOME=/tmp chroot /mnt /usr/local/bin/claude --version 2>&1); then
		v=$(echo "$v" | head -n 1)
		umount /mnt/dev /mnt/proc /mnt/tmp && umount /mnt && echo "HCC-INSTALL-OK $v"
	else
		echo "HCC-INSTALL-ERROR could not add Claude Code to the image"
	fi
	;;
esac
echo "HCC-GUEST-DONE no agent runtime in this image; shutting down"
hcc_shutdown
