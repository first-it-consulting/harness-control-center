# Guest kernel for the vz provider (ADR-0016): arm64 defconfig plus these.
# Every option here is checked after "make olddefconfig"; a build fails if
# one did not take.

# Nothing in the guest can add kernel code.
# CONFIG_MODULES is not set

# The devices Apple's Virtualization framework provides (virtio over PCI).
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# What the images' inits use.
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Not needed: no network device ever reaches the guest, and no tunnel
# device should appear either.
# CONFIG_VIRTIO_NET is not set
# CONFIG_IPV6_SIT is not set

# Hardware a sandbox never has: less kernel code within the agent's reach
# (and a much shorter build).
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_CAN is not set
